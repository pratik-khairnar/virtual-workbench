# Virtual Workbench — Environment Configuration
# Copy this to .env and fill in values

PORT=3001

# Webhook secret — must match the secret configured in Gitea/GitHub
WEBHOOK_SECRET=dev-secret-change-in-production

# Storage paths (defaults work for local dev)
# DB_PATH=./data/workbench.db
# IMAGE_STORAGE_PATH=./data/images
# CATALOG_MANIFEST_PATH=./data/catalog

# Set to 'true' if Trivy is installed and you want vulnerability scanning
ENABLE_VULN_SCAN=false

# Container registry (Docker Hub, Harbor, or local)
CONTAINER_REGISTRY=localhost:5000

# Alert webhook URL (optional — Slack, Discord, etc.)
# ALERT_WEBHOOK_URL=https://hooks.slack.com/services/...
